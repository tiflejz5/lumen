{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wiedza-baza/schema/user-state.schema.json",
  "title": "Stan użytkownika (NIE jest częścią bazy)",
  "description": "Specyfikacja danych, które aplikacja tworzy lokalnie: sesje, oceny, flagi, notatki, powtórki. Przechowywane osobno od bazy, kluczowane po topic_id, więc import nowej wersji bazy ich nie nadpisuje.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_state_version", "topics"],
  "properties": {
    "user_state_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "topics": {
      "type": "object",
      "propertyNames": { "pattern": "^(fin|nau|zdr|his|psy|ogo)-[0-9]{4}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["started_at", "topic_revision", "completed"],
              "properties": {
                "started_at": { "type": "string", "format": "date-time" },
                "topic_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Rewizja tematu, na której odbyła się sesja."
                },
                "completed": { "type": "boolean" },
                "minutes_spent": { "type": "integer", "minimum": 0 },
                "extended_opened": { "type": "boolean" },
                "quiz_score": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["correct", "total"],
                  "properties": {
                    "correct": { "type": "integer", "minimum": 0 },
                    "total": { "type": "integer", "minimum": 1 }
                  }
                },
                "ratings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "interest": { "$ref": "#/$defs/scale5" },
                    "new_knowledge": { "$ref": "#/$defs/scale5" },
                    "usefulness": { "$ref": "#/$defs/scale5" },
                    "perceived_difficulty": {
                      "$ref": "#/$defs/scale5",
                      "description": "1 = bardzo łatwy, 3 = w sam raz, 5 = bardzo trudny"
                    },
                    "materials_quality": { "$ref": "#/$defs/scale5" }
                  }
                },
                "flags": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": ["too_easy", "too_hard", "too_general", "deepen", "not_interesting"]
                  }
                },
                "note": { "type": "string" },
                "recording_ref": {
                  "type": "string",
                  "description": "Ścieżka/identyfikator pliku nagrania w lokalnym magazynie aplikacji."
                }
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "description": "Stan powtórek (np. uproszczony algorytm interwałowy).",
            "properties": {
              "next_review_at": { "type": "string", "format": "date" },
              "interval_days": { "type": "integer", "minimum": 0 },
              "ease": { "type": "number", "minimum": 1.3, "maximum": 3.0 },
              "suspended": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "scale5": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}
