{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wiedza-baza/schema/pack.schema.json",
  "title": "Paczka tematów",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "schema_version", "created_at", "description", "topics"],
  "properties": {
    "pack_id": { "type": "string", "pattern": "^pack-[0-9]{3}$" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "created_at": { "type": "string", "format": "date" },
    "description": { "type": "string", "maxLength": 300 },
    "is_example": {
      "type": "boolean",
      "description": "true = paczka demonstracyjna; importer jej nie ładuje do bazy produkcyjnej."
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "topic.schema.json" }
    }
  }
}
