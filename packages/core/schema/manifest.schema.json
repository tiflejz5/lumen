{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wiedza-baza/schema/manifest.schema.json",
  "title": "Manifest wydania bazy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_name",
    "base_version",
    "schema_version",
    "taxonomy_version",
    "released_at",
    "files",
    "stats"
  ],
  "properties": {
    "base_name": { "type": "string" },
    "base_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "taxonomy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "released_at": { "type": "string", "format": "date" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "role": { "enum": ["pack", "sources", "taxonomy", "paths"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "topic_count": { "type": "integer", "minimum": 0 },
          "is_example": { "type": "boolean" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["total_topics"],
      "properties": {
        "total_topics": { "type": "integer", "minimum": 0 },
        "by_category": { "type": "object", "additionalProperties": { "type": "integer" } },
        "by_difficulty": { "type": "object", "additionalProperties": { "type": "integer" } },
        "by_topic_type": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    }
  }
}
